# Copy to .env.local and fill in.

# Base URL of the Laravel API, including the /api prefix. Server-only: it must
# never be exposed to the browser, since all Laravel traffic goes through the
# Next.js server (Server Components) or the BFF proxy route handler.
LARAVEL_API_URL=http://localhost:8000/api

# Key used to seal the httpOnly session cookie (jose, HS256). Generate with:
#   openssl rand -base64 32
SESSION_SECRET=
